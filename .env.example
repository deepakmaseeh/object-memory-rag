# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=objectmemory
NEO4J_BACKEND=auto

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PREFER_LOCAL=true

# Ollama
