OLLAMA_RAG_MODEL=qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEVICE=auto
